// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AwardRuleId {
  FIRST_LOGIN
  TEST_EVENT
}

model UserWallet {
  id Int @id @default(autoincrement())

  //uid will be deprecated in favor of uidNew, but we keep it for backward compatibility with existing data
  uid    String? @unique
  uidNew String? @unique @map("uid_new")

  address   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_wallets")
}

model AwardRule {
  id            String      @id @default(uuid())
  eventId       String
  source        String
  relativeValue Int
  rewardAmount  Int
  maxPerUser    Int
  maxPerDay     Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userAwards    UserAward[]
}

model UserAward {
  id Int @id @default(autoincrement())

  //uid will be deprecated in favor of uidNew, but we keep it for backward compatibility with existing data
  uid    String?
  uidNew String? @map("uid_new")

  awardRuleId String   @map("award_rule_id")
  count       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  awardRule AwardRule @relation(fields: [awardRuleId], references: [id])

  @@unique([uid, awardRuleId])
  @@unique([uidNew, awardRuleId])
  @@map("user_awards")
}

model TxLog {
  id     Int     @id @default(autoincrement())
  //uid will be deprecated in favor of uidNew, but we keep it for backward compatibility with existing data
  uid    String?
  uidNew String? @map("uid_new")

  address        String
  type           String
  eventId        String?   @map("event_id")
  label          String?
  amount         Decimal
  txHash         String    @map("tx_hash")
  chainId        Int       @map("chain_id")
  eventTimestamp DateTime? @map("event_timestamp")
  source         String?
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("tx_log")
}

model File {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  name     String
  mimeType String  @map("mime_type")
  size     Int
  private  Boolean @default(false)

  @@map("files")
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  name         String
  email        String @unique()
  password     String
  Role         Role   @relation(fields: [roleId], references: [id])
  roleId       Int    @map("role_id")
  refreshToken String @map("refresh_token")

  @@map("users")
}

model Role {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  name        String       @unique
  Users       User[]
  permissions Permission[]

  @@map("roles")
}

model Permission {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  permission PermissionEnum @unique
  roles      Role[]

  @@map("permissions")
}

enum PermissionEnum {
  PERM_ALL // will have permission to all endpoints

  PERM_USER_ALL
  PERM_USER_CREATE
  PERM_USER_READ
  PERM_USER_UPDATE
  PERM_USER_DELETE

  PERM_ROLE_ALL
  PERM_ROLE_CREATE
  PERM_ROLE_READ
  PERM_ROLE_UPDATE
  PERM_ROLE_DELETE

  PERM_PERMISSION_ALL
  PERM_PERMISSION_CREATE
  PERM_PERMISSION_READ
  PERM_PERMISSION_UPDATE
  PERM_PERMISSION_DELETE

  @@map("PermissionEnum")
}
