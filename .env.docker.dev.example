# Optional root-level overrides for docker-compose.dev.yml.
# Copy this file to .env only if you want values different from the defaults.

DEV_DOCKER_NETWORK=energenius-dev

CORE_HOST_PORT=3001
FRONTEND_HOST_PORT=3000
POSTGRES_HOST_PORT=5433

DEV_POSTGRES_USER=award
DEV_POSTGRES_PASSWORD=award
DEV_POSTGRES_DB=award

DEV_APP_VERSION=dev
LOG_DESTINATION=console
DEV_JWT_ACCESS_SECRET=dev-access-secret
DEV_JWT_REFRESH_SECRET=dev-refresh-secret

# Browser-facing URLs used by the Next.js dev server.
DEV_NEXT_PUBLIC_API_URL=http://localhost:3001/v1
DEV_NEXT_PUBLIC_NEXUS_API_URL=http://localhost:3003

# Container-facing blockchain config used by the NestJS backend.
# Defaults let the backend boot; point these at a real local chain when award/spend flows need it.
DEV_AMOY_RPC_URL=http://host.docker.internal:8545
DEV_CHAIN_ID=31337
DEV_ENCOIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
DEV_AMOY_PRIVATE_KEY=0x59c6995e998f97a5a0044966f09453844f1a87adf9d7a3e7c665680dec2c8943

# Container-facing URLs used by the NestJS backend.
# Put the target container on DEV_DOCKER_NETWORK, then use its container name or network alias here.
DEV_NEXUS_URL=http://nexus-app:3003
DEV_TOKEN_INTROSPECTION_URL=http://nexus-app:3003/auth/token/introspect
